{
	chapter.022131FC544A9543.chapter_subtitle: [
		"The Factory Must Grow + Chemica: кислоты, топливо, пластик и взрывчатка."
	]
	chapter.022131FC544A9543.title: "Химия"
	chapter.0D5FEB1964282266.chapter_subtitle: [
		"Мало, далеко и опасно: существуют только необходимые постройки."
	]
	chapter.0D5FEB1964282266.title: "Исследование"
	chapter.0F04D28CD522179C.chapter_subtitle: [
		"Полезные функции, о которых стоит знать. Отмечайте задания и забирайте опыт."
	]
	chapter.0F04D28CD522179C.title: "Советы и инструменты"
	chapter.1984337FCA8F77EB.chapter_subtitle: ["Жар, латунь и точность."]
	chapter.1984337FCA8F77EB.title: "Промышленное производство"
	chapter.2218ACE80C232364.chapter_subtitle: [
		"Превратите опыт в жидкость и зачаровывайте на конвейере."
	]
	chapter.2218ACE80C232364.title: "Зачарование и опыт"
	chapter.3573F24E55D6B754.chapter_subtitle: [
		"От водяных колёс до дизельных двигателей и электричества."
	]
	chapter.3573F24E55D6B754.title: "Энергия и двигатели"
	chapter.39CCB32D95EDFDBC.chapter_subtitle: [
		"Хорошо питайтесь и автоматизируйте кухню."
	]
	chapter.39CCB32D95EDFDBC.title: "Еда и фермерство"
	chapter.3CA8F5487B175644.chapter_subtitle: [
		"После первого шара: умные корабли и наземный транспорт."
	]
	chapter.3CA8F5487B175644.title: "Транспорт и полёты"
	chapter.3D343A4500907F62.chapter_subtitle: [
		"Перемещение предметов: ленты, воронки, манипуляторы, механизмы и поезда."
	]
	chapter.3D343A4500907F62.title: "Логистика и автоматизация"
	chapter.484C50D5A767A23B.chapter_subtitle: ["Украсьте свои острова и корабли."]
	chapter.484C50D5A767A23B.title: "Музыка, искусство и развлечения"
	chapter.4D7374CABA86D47E.chapter_subtitle: [
		"Добро пожаловать в Skyworks: Industrial Arcana."
	]
	chapter.4D7374CABA86D47E.title: "Начало пути"
	chapter.530CF590B4210688.chapter_subtitle: [
		"Сила вращения: валы, шестерни, водяные колёса и первые машины."
	]
	chapter.530CF590B4210688.title: "Основы Create"
	chapter.549A1F4BC406BB91.chapter_subtitle: [
		"Create: Cybernetics: собирайте импланты на линиях Create, ставьте их в кинетическом кресле, улучшайте до Mk. V."
	]
	chapter.549A1F4BC406BB91.title: "Кибернетика"
	chapter.5B6DC45A962FF50B.chapter_subtitle: [
		"Create Aeronautics: стройте всё, что летает."
	]
	chapter.5B6DC45A962FF50B.title: "Постройка дирижаблей"
	chapter.655FD9D9E7DB0EC5.chapter_subtitle: [
		"Массовая обработка вентиляторами и машинами Dreams \\& Desires."
	]
	chapter.655FD9D9E7DB0EC5.title: "Обработка вентиляторами и Dreams \\& Desires"
	chapter.662854369199D65B.chapter_subtitle: [
		"Большие заводы, большие корабли, большие пушки."
	]
	chapter.662854369199D65B.title: "Продвинутая инженерия"
	chapter.703BA404AFB6FCB2.chapter_subtitle: [
		"Еда, дерево, камень и вода: первые ночи в небе."
	]
	chapter.703BA404AFB6FCB2.title: "Выживание на острове"
	chapter.749661DF67B670C0.chapter_subtitle: ["Превратите булыжник во всё остальное."]
	chapter.749661DF67B670C0.title: "Автоматизация ресурсов"
	chapter.7994EBAE30A63934.chapter_subtitle: [
		"Программируемая магия: рисуйте узоры, собирайте заклинания, автоматизируйте фокусами."
	]
	chapter.7994EBAE30A63934.title: "Hex Casting"
	chapter.7E12579408EECDD7.chapter_subtitle: [
		"Create Big Cannons и Create: Gunsmithing: литьё, расточка, заряжание и стрельба."
	]
	chapter.7E12579408EECDD7.title: "Артиллерия и оружие"
	quest.00625A41041CA95C.quest_desc: [
		"Физический сборщик превращает склеенную постройку в настоящий физический объект (подуровень Sable)."
		"Сначала склейте постройку суперклеем или медовым клеем. Ponder (W) объясняет каждый шаг."
	]
	quest.00625A41041CA95C.title: "Физический сборщик"
	quest.00FC0828845E5A84.quest_desc: [
		"Глубокие моря пустоты шириной в тысячи блоков разделяют континенты островов. Пересечь их может лишь дальний дирижабль."
	]
	quest.00FC0828845E5A84.title: "Дальний рубеж"
	quest.01D3FE298EE3B843.quest_desc: [
		"Примерно один алмаз на 10 000 просеянного гравия: стоит того только с полностью автоматической линией сит."
	]
	quest.01D3FE298EE3B843.title: "Алмазы из гравия"
	quest.0207448289456B89.quest_desc: [
		"Сборщик пушек собирает огромные скреплённые стволы. Сталь и адская сталь выдерживают больше пороха."
	]
	quest.0207448289456B89.title: "Скреплённые стволы"
	quest.0216FB8B6A4A0E9B.quest_desc: [
		"Генератор блоков на вращении: вода и лава рядом дают булыжник; другие пары и блок-катализатор"
		"под ним дают базальт, андезит, глубинный сланец, эндерняк и даже рудные камни Create. Все сочетания есть в JEI."
	]
	quest.0216FB8B6A4A0E9B.title: "Механический экструдер"
	quest.02873DF550E49C6A.quest_desc: [
		"Поставьте нейропорт на машину Create, переименуйте на наковальне и привяжите: дек читает её скорость и нагрузку."
		"Андезитовый корпус, медный лист, редстоун и электронная лампа."
	]
	quest.02873DF550E49C6A.title: "Нейропорт"
	quest.03C6819876A29603.quest_desc: [
		"Налейте в стеклянную бутылку 250 мБ нейрогеля. Он подавляет нейросбои на 10 минут"
		"(первые 5 секунд тошнит). Держите запасной на большие бои, когда нагрузка выше ёмкости."
	]
	quest.03C6819876A29603.title: "Нейростабилизатор"
	quest.043ADD6730F552D2.quest_desc: [
		"Встаньте на работающую кинетическую зарядку, чтобы быстро восполнить заряд: |об/мин| / 8 в секунду (нужно хотя бы 16 об/мин)."
		"Андезитовый корпус, медный лист, блок редстоуна и вал."
	]
	quest.043ADD6730F552D2.title: "Кинетическая зарядка"
	quest.047CF9509B29D623.quest_desc: [
		"Хранилища вмещают огромные объёмы и работают с биржевыми тикерами."
	]
	quest.047CF9509B29D623.title: "Большое хранилище"
	quest.047FD320CC94C71D.quest_desc: [
		"Хирургический табурет: андезитовый корпус, железный лист, точный механизм, вал и шестерня (верстак)."
		"Подведите вращение к редуктору сзади и залейте бак (1000 мБ) гелем."
		"ПКМ по креслу, выберите имплант и щёлкните по светящемуся узлу. Не вставайте до конца операции."
		"Нужно 16 / 32 / 64 / 128 / 256 об/мин для Mk. I-V."
	]
	quest.047FD320CC94C71D.title: "Кресло имплантации"
	quest.048A3F85B99426D5.quest_desc: [
		"Cocktails Delight: больше 40 коктейлей из крепких напитков, соков и сиропов."
	]
	quest.048A3F85B99426D5.title: "Бармен"
	quest.04CBC978BAA4EDF0.quest_desc: [
		"Сохраните постройку схемой и пером, а схематическая пушка её напечатает — идеально для копирования кораблей."
	]
	quest.04CBC978BAA4EDF0.title: "Схемы"
	quest.04F017B8544278BD.quest_desc: [
		"F3 показывает координаты, биом, освещённость и TPS удобными группами (BetterF3) — пригодится для навигации."
	]
	quest.04F017B8544278BD.title: "Better F3"
	quest.053A6D8A53C8EB6F.quest_desc: [
		"Показывают высоту, скорость и подъёмную силу в полёте."
	]
	quest.053A6D8A53C8EB6F.title: "Очки авиатора"
	quest.058EEC1B4A5712A0.quest_desc: [
		"Медные листы идут на нейро- и оптические импланты, железные - на механические."
		"Прессуйте слитки механическим прессом (над депо или лентой)."
		"Медь: 2 руды на стартовом острове, руда на соседних островах или самородки из просеянного гравия."
	]
	quest.058EEC1B4A5712A0.title: "Медные и железные листы"
	quest.05D99B7731036E77.quest_desc: [
		"&eSkyworks:&r дробильные колёса перемалывают осколки аметиста в аметистовую пыль — стабильный источник медиа от промышленности."
	]
	quest.05D99B7731036E77.title: "Медиа"
	quest.06E97EB22173E7E2.quest_desc: [
		"Эпоксидная смола застывает в прочные листы для сложных деталей и печатных плат."
	]
	quest.06E97EB22173E7E2.title: "Эпоксидка"
	quest.0873A2AF842F84BC.quest_desc: [
		"Животные появляются на травяных островах, а не на стартовом. Приведите пару одного вида на поводке (или возьмите яйца/пшеницу)."
	]
	quest.0873A2AF842F84BC.title: "Скот"
	quest.08A9064A0671DA27.quest_desc: [
		"Боксит (острова или цинковое сито) → алюминий: лёгкие трубы и детали."
	]
	quest.08A9064A0671DA27.title: "Алюминий"
	quest.095BD892863141B0.quest_desc: [
		"Валы передают вращение, шестерни меняют направление и скорость. Наденьте инженерные очки, чтобы видеть скорость и нагрузку."
	]
	quest.095BD892863141B0.title: "Валы и шестерни"
	quest.09FAF6DAD988803E.quest_desc: [
		"Быстрее атака, натяжение лука, еда и питьё. Каркас из медных листов, редстоун, электронная лампа и перо."
	]
	quest.09FAF6DAD988803E.title: "Усилитель рефлексов"
	quest.0AC1F932FE649DE5.quest_desc: [
		"Create Propulsion: топливные двигатели толкают дирижабль без пропеллеров; векторные — ещё и рулят."
	]
	quest.0AC1F932FE649DE5.title: "Двигатели тяги"
	quest.0B8BFB2B842ECA42.quest_desc: [
		"Желоба перемещают предметы вертикально; воронки вставляют и извлекают. Добавьте фильтр для сортировки."
	]
	quest.0B8BFB2B842ECA42.title: "Воронки и желоба"
	quest.0B98054EBE7A95CA.quest_desc: [
		"Раскачивайтесь между островами — крюк цепляется и за механизмы, и за летящие дирижабли."
		"Улучшайте его на блоке модификации крюка."
	]
	quest.0B98054EBE7A95CA.title: "Крюк-кошка"
	quest.0C31FEEDB9F4C0F8.quest_desc: [
		"Рис растёт в воде — полезная культура для маленьких небесных прудов. Дикие семена — просеиванием земли через нитяное сито."
	]
	quest.0C31FEEDB9F4C0F8.title: "Рис"
	quest.0F39EE6AE7A9ACCD.quest_desc: [
		"Naturalist населяет биомы островов оленями, медведями, птицами, змеями и другими. Некоторые опасны."
	]
	quest.0F39EE6AE7A9ACCD.title: "Дикая природа"
	quest.10DA5E02C270D901.quest_desc: [
		"Механические крафтеры автоматически собирают самые большие рецепты Create."
	]
	quest.10DA5E02C270D901.title: "Механический крафт"
	quest.11BFB4F22BD634E3.quest_desc: [
		"Каркас каждого импланта, кресла и зарядки."
		"Очищенное бревно + андезитовый сплав, наносится деплоером или вручную."
	]
	quest.11BFB4F22BD634E3.title: "Андезитовый корпус"
	quest.1240C391276915FF.quest_desc: [
		"Подшипники пропеллера с парусами или пропеллерами толкают аппарат. Питайте их двигателем на борту."
	]
	quest.1240C391276915FF.title: "Движение"
	quest.125EB5DB35168DE7.quest_desc: [
		"Interiors добавляет стулья, напольные кресла и подушки — они же служат сиденьями на механизмах."
	]
	quest.125EB5DB35168DE7.title: "Мебель"
	quest.12D9F75E3D5FCD93.quest_desc: [
		"Спрессуйте золотые слитки. Каждый цикл Mk. III кладёт золотой лист и точный механизм."
	]
	quest.12D9F75E3D5FCD93.title: "Золотые листы"
	quest.1368B515D7B2C490.quest_desc: [
		"Смешайте нитрат, серу и древесный уголь: настоящий чёрный порох — основа любого орудийного заряда."
	]
	quest.1368B515D7B2C490.title: "Промышленный порох"
	quest.136A169C6FD1844F.quest_desc: [
		"&eУдарные демпферы&r гасят урон от падения - кстати, когда промахнулся между островами."
		"Каждый имплант Mk. I - рецепт механических крафтеров: каркас из листов и корпусов, деталь категории и ключевой предмет"
		"(здесь блок слизи, костный блок и шестерня). JEI покажет все. &cПустота по-прежнему смертельна.&r"
	]
	quest.136A169C6FD1844F.title: "Пережить падение"
	quest.13BAF85D2022768D.quest_desc: [
		"Central Kitchen позволяет машинам Create готовить в кастрюлях и собирать пиршества. Автоматические рецепты — в JEI."
	]
	quest.13BAF85D2022768D.title: "Central Kitchen"
	quest.13F29962F97FC8A8.quest_desc: [
		"Контроллеры огня сами наводят пушки Create Big Cannons на цели радара — ПВО для дирижабля."
	]
	quest.13F29962F97FC8A8.title: "Управление огнём"
	quest.149CBDCB055B4350.quest_desc: [
		"Корабль со своими бурами, дробилками или печами. Проверьте, какие машины продолжают работать в полёте."
	]
	quest.149CBDCB055B4350.title: "Промышленный дирижабль"
	quest.16412B600BED18C0.quest_desc: [
		"Crafting Tweaks добавляет рядом с сеткой кнопки «повернуть / выровнять / очистить»."
	]
	quest.16412B600BED18C0.title: "Хитрости сетки крафта"
	quest.1780EA83C7CA151F.quest_desc: [
		"Накладывает выбранные зачарования, расходуя жидкий опыт."
	]
	quest.1780EA83C7CA151F.title: "Зачарователь ифрита"
	quest.179897714058F33B.quest_desc: [
		"Гильзы прессуют из листов и снаряжают порохом и снарядом."
	]
	quest.179897714058F33B.title: "Гильзы"
	quest.19D255D18F29A064.quest_desc: [
		"Коксовые печи делают из угля кокс, доменная печь — сталь. Сталь открывает химию TFMG и тяжёлую технику."
	]
	quest.19D255D18F29A064.title: "Сталь (TFMG)"
	quest.1A871083B1AA5B0A.quest_desc: [
		"Нагрузка, скорость и мощность — с одного взгляда."
	]
	quest.1A871083B1AA5B0A.title: "Инженерные очки"
	quest.1AF5C624C98B95D0.quest_desc: [
		"Create Winery: давите виноград, сбраживайте сусло в винном погребе и разливайте мерло, рислинг, шампанское..."
	]
	quest.1AF5C624C98B95D0.title: "Винодельня"
	quest.1B9D4C0C9F418483.quest_desc: [
		"Отметьте цель для орудий, просто посмотрев на неё."
	]
	quest.1B9D4C0C9F418483.title: "Бинокль"
	quest.1C4351D1C551CA00.quest_desc: [
		"Латунное сито просеивает из гравия дроблёную руду и лазурит. Просеивание — медленная лотерея: каждый результат выпадает с шансом 1/800"
		"(медь и железо 1/1000, алмазы 1/10000) — окупается только в промышленном масштабе."
	]
	quest.1C4351D1C551CA00.title: "Латунные и улучшенные сита"
	quest.1C997BA606DB131E.quest_desc: [
		"Jade показывает сведения о блоке, машине или мобе вверху экрана — в том числе на дирижаблях."
	]
	quest.1C997BA606DB131E.title: "На что я смотрю?"
	quest.1D55CAB33947BB91.quest_desc: [
		"Смешайте гнилую плоть (или гуано) с водой: возобновляемая селитра для пороховых линий."
	]
	quest.1D55CAB33947BB91.title: "Селитра"
	quest.1DC39079DB0B6EAC.quest_desc: [
		"Пластиковые листы, трубы и полимеры Chemica (ПВХ, эпоксидка) — лёгкие детали для летательных аппаратов и заводов."
	]
	quest.1DC39079DB0B6EAC.title: "Пластик"
	quest.1E6EF85A0D6A743D.quest_desc: [
		"Стыковочные коннекторы соединяют корабль со станцией или с другим кораблём."
	]
	quest.1E6EF85A0D6A743D.title: "Стыковка"
	quest.1FE66342C645AA64.quest_desc: [
		"Копирует написанные книги, зачарованные книги (за опыт) и многое другое."
	]
	quest.1FE66342C645AA64.title: "Печатник"
	quest.204FCFDF8959D187.quest_desc: [
		"Оболочки удерживают горячий воздух от горелки и дают подъёмную силу. Маленький шар — дешёвый первый транспорт между островами."
		"&eСовет:&r испытывайте новые аппараты над большим островом, а не над открытой пустотой."
	]
	quest.204FCFDF8959D187.title: "Воздушный шар"
	quest.207A6631CA77A8EC.quest_desc: [
		"Farmer's Delight: нарезайте ингредиенты и получайте больше с урожая."
	]
	quest.207A6631CA77A8EC.title: "Разделочная доска"
	quest.20864C47ADDE6FA2.quest_desc: [
		"Беспроводной редстоун: одинаковые два предмета частоты = один канал. Отлично для дирижаблей."
	]
	quest.20864C47ADDE6FA2.title: "Редстоун-связь"
	quest.21007690B1802585.quest_desc: [
		"Create Deco, Copycats+ и Bells \\& Whistles добавляют мостки, листовой металл, лампы и блоки-копировщики."
		"Блоки-копировщики ещё и лёгкие — хороши для дирижаблей."
	]
	quest.21007690B1802585.title: "Индустриальный стиль"
	quest.21010365EB437DA9.quest_desc: [
		"Заряжайте с казённой части: сначала снаряд, затем пороховые заряды. Заряды делают из промышленного пороха."
	]
	quest.21010365EB437DA9.title: "Ядро и порох"
	quest.2270F3906EA75CD8.quest_desc: [
		"Разбрызгиватели поливают и удобряют грядки под собой."
	]
	quest.2270F3906EA75CD8.title: "Разбрызгиватели"
	quest.232C1A4D540EB516.quest_desc: [
		"По вертикальным верёвкам, свисающим с дирижабля, можно лазать: ПКМ пустой рукой, чтобы ухватиться."
	]
	quest.232C1A4D540EB516.title: "Верёвочные лестницы"
	quest.24A3A06E232FB8AB.quest_desc: [
		"Окружите родной остров артиллерийскими батареями, которые снабжает завод боеприпасов."
	]
	quest.24A3A06E232FB8AB.title: "Оборонительная база"
	quest.2578CF523A5596C7.quest_desc: [
		"Фокус хранит одну йоту, книга заклинаний — много. Сохраняйте лучшие узоры, а не рисуйте их заново."
	]
	quest.2578CF523A5596C7.title: "Хранение йот"
	quest.2606AE0F402C0C0D.quest_desc: ["Смешивание меди и цинка с нагревом."]
	quest.2606AE0F402C0C0D.title: "Латунь"
	quest.261DCE85CA3EC23A.quest_desc: [
		"Фугасным снарядам нужен взрыватель. Пироксилин и нитропорох (с вашей химической линии) дают более мощные заряды."
	]
	quest.261DCE85CA3EC23A.title: "Фугасы"
	quest.26819DDA8D6AC98A.quest_desc: [
		"Протравленные платы из ПВХ или эпоксидки становятся электронными схемами для сложных машин."
	]
	quest.26819DDA8D6AC98A.title: "Печатные платы"
	quest.272B0C722280A1D7.quest_desc: [
		"Ваша первая поэтапная сборка. Точные механизмы нужны для латунных машин, управления дирижаблем и многого другого."
	]
	quest.272B0C722280A1D7.title: "Точный механизм"
	quest.27B30E8200C23C8D.quest_desc: [
		"Цинк — из цинковой руды на островах или из просеивания гравия. Медь + цинк = латунь — когда появится жар."
	]
	quest.27B30E8200C23C8D.title: "Цинк"
	quest.280386B01AECC978.quest_desc: [
		"С химикатами Chemica работают в колбах и баках; JEI показывает каждую реакцию и нужную сборку чана."
	]
	quest.280386B01AECC978.title: "Лабораторная посуда Chemica"
	quest.282E199C98DB595B.quest_desc: [
		"Пульты Aeroworks вмещают джойстики, рычаги тяги, переключатели и кнопки, управляющие редстоун-связью."
	]
	quest.282E199C98DB595B.title: "Пульт управления"
	quest.284530AC7B4B9F11.quest_desc: [
		"Сундуки в постройках — сундуки Lootr: каждый игрок получает свою добычу, включая стартовый сундук."
	]
	quest.284530AC7B4B9F11.title: "Добыча для всех"
	quest.287CBEDA12BE6991.quest_desc: [
		"Помогает держать курс над однообразной пустотой."
	]
	quest.287CBEDA12BE6991.title: "Штурманский стол"
	quest.29AD25AD6BB03312.quest_desc: [
		"Пустите лаву течь рядом с водой (не на стоячую воду!) — получится бесконечный генератор булыжника."
		"Берегите ведро лавы: она ценна, пока нет фермы на капельнике."
	]
	quest.29AD25AD6BB03312.title: "Генератор булыжника"
	quest.2A3FFB822D4CC670.quest_desc: [
		"Just Zoom добавляет клавишу приближения (по умолчанию &eC&r) — удобно разглядывать далёкие острова. Подзорная труба тоже подойдёт."
	]
	quest.2A3FFB822D4CC670.title: "Приближение"
	quest.2B20660D8E8F4C21.quest_desc: [
		"Сделайте обсидиан, вылив воду на стоячую лаву. Нужно 10 блоков (или 14 с углами)."
		"Незер — пустота в отсветах лавы с крошечными редкими островками. Стержни ифрита — из крепости, древние обломки — только из незерских метеоров."
		"Латунь, горелка ифрита и адский нарост требуют похода в Незер — это часть обычного развития."
	]
	quest.2B20660D8E8F4C21.title: "Свой портал"
	quest.2B5364EB62261241.quest_desc: [
		"Kvass Delight: заквасьте хлеб в бочонке. Есть ещё ягодный, свекольный, имбирный и монастырский квас."
	]
	quest.2B5364EB62261241.title: "Квас"
	quest.2B537C304A531294.quest_desc: [
		"Вырастите просветлённое дерево заклинанием; из его древесины строят акашические библиотеки."
	]
	quest.2B537C304A531294.title: "Просветлённые деревья"
	quest.2B5987C75259F4F7.quest_desc: [
		"Записывайте свою музыку на чистые пластинки по ссылке; её услышат все рядом."
	]
	quest.2B5987C75259F4F7.title: "Записи Etched"
	quest.2B70BAF8E8E73151.quest_desc: [
		"Дробление руды и многие процессы дают самородки опыта. Собирайте их!"
	]
	quest.2B70BAF8E8E73151.title: "Самородки опыта"
	quest.2BCE767F9AB9192C.quest_desc: [
		"Гироскопические подшипники держат корабль ровно."
	]
	quest.2BCE767F9AB9192C.title: "Стабилизаторы"
	quest.2BD84482972DFE5E.quest_desc: [
		"Brewin' and Chewin': бочонок со временем сбраживает напитки и выдерживает сыры. Держите его в тепле или холоде, как требует рецепт (JEI)."
		"Крепкие напитки вызывают опьянение — не управляйте дирижаблем пьяным."
	]
	quest.2BD84482972DFE5E.title: "Бочонок"
	quest.2BF25DB32E16C19D.quest_desc: [
		"Better Third Person: удерживайте клавишу свободного обзора, чтобы облететь камерой персонажа (и дирижабль)."
		"First-person Model показывает тело; Paper Doll — мини-модель персонажа. Оба настраиваются в «Моды → Настройки»."
	]
	quest.2BF25DB32E16C19D.title: "Трюки с камерой"
	quest.2C5F05C27BDCC359.quest_desc: [
		"У TFMG своя электросеть с напряжением: генераторы, кабели, моторы и лампы."
	]
	quest.2C5F05C27BDCC359.title: "Электричество TFMG"
	quest.2E4FC12FBDE25B1C.quest_desc: [
		"Подшипник мельницы с парусами крутится без воды — идеально для маленьких островов."
	]
	quest.2E4FC12FBDE25B1C.title: "Сила ветра"
	quest.2F51C5D0B1C66EDB.quest_desc: [
		"Реактивные фокусы запускают хекс, когда с вами что-то происходит: получение урона, выстрел, телепортация..."
		"Им нужен разум жителя — деревень нет, так что вылечите зомби-жителя."
	]
	quest.2F51C5D0B1C66EDB.title: "Реактивные фокусы (HexAutomata)"
	quest.2FFED2542AD40AFC.quest_desc: [
		"Вентилятор, дующий сквозь воду, промывает предметы на лентах или на земле: гравий → железные самородки, песок → глина."
	]
	quest.2FFED2542AD40AFC.title: "Промывка"
	quest.3058E43087BA45F2.quest_desc: [
		"Mk. IV = деталь категории, прочный лист, незеритовый лом, нейрогель и пресс - три цикла."
		"Креслу нужно 128 об/мин и нейрогель. Три жидкости и куча листов на одной ленте - пора строить отдельную автоматическую линию."
	]
	quest.3058E43087BA45F2.title: "Грейд IV: военный"
	quest.308A023FE20493AC.quest_desc: [
		"Nullscape превращает Край в странный парящий ландшафт."
	]
	quest.308A023FE20493AC.title: "Чужой Край"
	quest.3093170146DFCD69.quest_desc: [
		"Последовательная сборка Create (шаги покажет JEI): золотой лист, шестерни и железный самородок на ленте."
		"Он нужен креслу, ядру, каждой детали кибердека и каждому улучшению до Mk. III."
	]
	quest.3093170146DFCD69.title: "Точный механизм"
	quest.30F541F503D618A2.quest_desc: [
		"Крылья создают подъёмную силу от скорости: быстрые самолёты вместо медленных аэростатов."
	]
	quest.30F541F503D618A2.title: "Крылья"
	quest.319815C3409B4348.quest_desc: [
		"Показывает скрытые сведения о блоках и йотах — незаменима для отладки хексов."
	]
	quest.319815C3409B4348.title: "Линза прозрения"
	quest.31C05BB32C6ADD6C.quest_desc: [
		"Упаковщики, лягушкопорты и биржевые тикеры перемещают предметы между заводами — даже между островами."
	]
	quest.31C05BB32C6ADD6C.title: "Логистика Create"
	quest.31CBBB1555002780.quest_desc: [
		"Нейрогелю и латуни нужен нагрев. Горелке ифрита нужен живой ифрит: крепость Нижнего мира в 1000+ блоках от центра,"
		"так что готовьте шар или длинный мост. Топливо даёт нагрев в миксере."
	]
	quest.31CBBB1555002780.title: "Жар для линии"
	quest.31F8EB8D56C290B8.quest_desc: [
		"Эндермены появляются на островах ночью. Крепости генерируются — частично в воздухе — не ближе 1280 блоков;"
		"око Эндера по-прежнему указывает путь."
	]
	quest.31F8EB8D56C290B8.title: "Око Эндера"
	quest.3206CABEBBBD2BB7.quest_desc: [
		"Миксер с нагревом: 250 мБ биогеля + лазурит + светящаяся пыль + аметист = 250 мБ нейрогеля."
		"Для Mk. IV и Mk. V кресло и улучшения требуют его вместо биогеля."
	]
	quest.3206CABEBBBD2BB7.title: "Нейрогель"
	quest.323351DB4428F158.quest_desc: [
		"Аккумуляторы запасают FE на ночь или на пиковые нагрузки."
	]
	quest.323351DB4428F158.title: "Хранение энергии"
	quest.32F32E9194FF47D9.quest_desc: [
		"Перезаряжаемые предметы-заклинатели, работающие на заряженном аметисте."
	]
	quest.32F32E9194FF47D9.title: "Артефакты"
	quest.338517D331B64692.quest_desc: [
		"2 андезита + 2 железных (или цинковых) самородка = 1 сплав. В ядре стартового острова есть немного андезита;"
		"на соседних островах его много."
	]
	quest.338517D331B64692.title: "Андезитовый сплав"
	quest.366E2764B15D35E1.quest_desc: [
		"Mk. III = деталь категории, точный механизм, 100 мБ биогеля, золотой лист и пресс - два цикла."
		"Креслу нужно 64 об/мин. Mk. III открывает новые способности: подсказка предмета показывает, что даёт каждый грейд."
		"Высокие грейды больше грузят нервную систему: проверьте ёмкость ядра перед улучшением."
	]
	quest.366E2764B15D35E1.title: "Грейд III: продвинутый"
	quest.368EDCCD2219A99C.quest_desc: [
		"Небесные острова слишком малы для аметистовых жеод: &eSkyworks&r позволяет вырастить аметист из кварца смешиванием с сильным нагревом."
	]
	quest.368EDCCD2219A99C.title: "Аметист"
	quest.36F73938F0D8A75F.quest_desc: [
		"Create: Cybernetics добавляет импланты: ядро в позвоночнике, затем железо для коры мозга, глаз, скелета, рук,"
		"крови, кожи и ног, а также программируемый кибердек."
		"Каждый имплант собирается машинами Create, ставится в &eкресле имплантации&r и улучшается с &eMk. I&r до &eMk. V&r."
		""
		"Нажмите &eH&r, чтобы открыть &eполевое руководство&r (его выдают при первом входе; книга и редстоун крафтят новое)."
		"Эта глава показывает, где в небе взять каждый ингредиент."
	]
	quest.36F73938F0D8A75F.title: "Плоть - слабый сплав"
	quest.37342F63DD4D8842.quest_desc: [
		"&eУсиленные сухожилия&r дают прыжок в воздухе (ключевой предмет: кроличья шкурка - кролики живут на пустынных и снежных островах)."
		"Он тратит немного заряда; ядро понемногу восполняет его само."
	]
	quest.37342F63DD4D8842.title: "Второй прыжок"
	quest.3737F87D389A0418.quest_desc: [
		"Удерживайте &eW&r над любым блоком или предметом Create, чтобы открыть анимированное обучение &ePonder&r."
		"Нажмите &eR&r / &eU&r на предмете, чтобы увидеть рецепты и применения (JEI). У Hex Casting есть своя книга."
		"Задания в этой книге — подсказки, а не преграды: все главы открыты с самого начала."
	]
	quest.3737F87D389A0418.title: "Где искать подсказки"
	quest.388BE251EA1E4DBB.quest_desc: [
		"Крепость — единственный источник стержней ифрита и скелетов-иссушителей, а её сундуки с сокровищами —"
		"единственное место, где найдётся шаблон незеритового улучшения."
	]
	quest.388BE251EA1E4DBB.title: "Крепость Незера"
	quest.39626EE2A800A898.quest_desc: [
		"Create Jetpack: баллон, летающий на сжатом воздухе. Заряжайте его как баллон (поставьте и дайте вращение) перед прыжками между островами."
		"Режим зависания помогает строить под островом."
	]
	quest.39626EE2A800A898.title: "Реактивный ранец"
	quest.3974C912809DFDDC.quest_desc: [
		"Латунные слитки (медь + цинк, миксер с нагревом), спрессованные в листы. Нужны каждому улучшению до Mk. II."
	]
	quest.3974C912809DFDDC.title: "Латунные листы"
	quest.39D8C348787F37F5.quest_desc: [
		"Пушки крепятся к кораблю при сборке; отдача толкает корабль. Ставьте их низко и по центру."
	]
	quest.39D8C348787F37F5.title: "Вооружённый дирижабль"
	quest.3B98F45B0185F105.quest_desc: [
		"Поезда Create ездят по путям, которые вы строите: мост-магистраль между двумя островами — классический проект."
	]
	quest.3B98F45B0185F105.title: "Поезда"
	quest.3B9E4F5CD8073BD3.quest_desc: [
		"Mk. V = деталь категории, осколок эха, незеритовый слиток, нейрогель и пресс - четыре цикла. Креслу нужно 256 об/мин."
		"Mk. V открывает коронные приёмы: временной якорь Сандевистана, всплеск регенератора, повторную маскировку и не только. Читайте подсказку."
		"Не ставьте имплант Mk. V, который нечем питать: 256 об/мин - это серьёзная трансмиссия."
	]
	quest.3B9E4F5CD8073BD3.title: "Грейд V: экспериментальный"
	quest.3C0083216B96355F.quest_desc: [
		"Скорострельные орудия на гильзах — отлично сбивают воздушные шары разбойников."
	]
	quest.3C0083216B96355F.title: "Автопушки"
	quest.3CBA5EAF23BC2E25.quest_desc: [
		"Разбейте два блока льда над твёрдым блоком — получите два источника воды. Два источника рядом дают бесконечный родник."
	]
	quest.3CBA5EAF23BC2E25.title: "Бесконечная вода"
	quest.3D71AFA61AD4E117.quest_desc: [
		"Механический бур напротив генератора булыжника работает бесконечно. Добавьте ленты или желоба."
	]
	quest.3D71AFA61AD4E117.title: "Автоматический булыжник"
	quest.3DC2A43025357516.quest_desc: [
		"В небе нет бедрока, поэтому нефть не скапливается под островами. Два источника:"
		" - станки-качалки на залежах нефти на дне &cНезера&r (Skyworks добавляет их туда);"
		" - &eбионефть Skyworks:&r прессование с сильным нагревом 8 листвы + вода (гидротермальное сжижение)."
	]
	quest.3DC2A43025357516.title: "Нефть в небе"
	quest.3DC4C152CC55D9CB.quest_desc: [
		"Emotecraft: &eB&r открывает колесо эмоций. Игроки на сервере видят ваши эмоции."
	]
	quest.3DC4C152CC55D9CB.title: "Эмоции"
	quest.3E02ACEA014A1C01.quest_desc: [
		"Паруса Dreams \\& Desires превращают вентилятор в заморозку, шлифовку, кипение и другие процессы (см. JEI)."
	]
	quest.3E02ACEA014A1C01.title: "Особые паруса"
	quest.40EA7A43631B0B8D.quest_desc: [
		"В «Настройки → Управление» есть строка поиска (Controlling). Многие моды добавляют клавиши — проверьте конфликты."
	]
	quest.40EA7A43631B0B8D.title: "Поиск по управлению"
	quest.41370BD350C0E8DF.quest_desc: [
		"Снимает зачарования, превращая их в жидкий опыт."
	]
	quest.41370BD350C0E8DF.title: "Механическое точило"
	quest.414C6F8E8D21CCFE.quest_desc: [
		"Острова у точки появления обычно в 30–120 блоках. Постройте мост из булыжника (присядьте у края!) или задумайтесь о первом воздушном шаре."
		"На соседних островах есть железная, медная, цинковая и угольная руда, андезит, животные и дерево."
	]
	quest.414C6F8E8D21CCFE.title: "До соседнего острова"
	quest.43202D5A66AA68CA.quest_desc: [
		"Если два мода используют один рецепт, Polymorph показывает в окне крафта кнопку выбора результата."
	]
	quest.43202D5A66AA68CA.title: "Конфликты рецептов"
	quest.445D656BD1368D26.quest_desc: [
		"Осколки эха лежат в &eдревних городах&r - больше 1000 блоков от спавна, часто над пустотой."
		"Летите на дирижабле. В тайниках древних свитков тоже бывают осколки. Каждый цикл Mk. V тратит один."
	]
	quest.445D656BD1368D26.title: "Эхо из глубины"
	quest.454AFE3E1C014864.quest_desc: [
		"Create Ore Excavation прячет бесконечные рудные жилы в чанках — даже над пустотой."
		"ПКМ искателем жил показывает жилы поблизости (атлас жил хранит список)."
	]
	quest.454AFE3E1C014864.title: "Рудные жилы"
	quest.456139704C9A6B31.quest_desc: [
		"Части пушек отливают из расплавленного металла в формах и растачивают орудийной дрелью — или крафтят напрямую на низком уровне."
	]
	quest.456139704C9A6B31.title: "Ствол и казённик"
	quest.4596943F040E26C7.quest_desc: [
		"Гатлинг с ручным приводом: нужен точный механизм и патронная лента."
	]
	quest.4596943F040E26C7.title: "Гатлинг"
	quest.45AF66D3C6A9D1C3.quest_desc: [
		"Большие гильзы заменяют россыпные пороховые заряды в скорострельных затворах."
	]
	quest.45AF66D3C6A9D1C3.title: "Большие гильзы"
	quest.46279D89BE16B6DF.quest_desc: [
		"Механический крафт из стали и латуни. Патроны к револьверу сходят с линии поэтапной сборки."
	]
	quest.46279D89BE16B6DF.title: "Револьвер"
	quest.46786A445AEB09F1.quest_desc: [
		"Заряжает предметы без проводов — и бьёт мобов током."
	]
	quest.46786A445AEB09F1.title: "Катушка Тесла"
	quest.468CB6960981D346.quest_desc: [
		"Лента соединяет два вала и перемещает предметы. Воронки кладут предметы на ленту и снимают их."
	]
	quest.468CB6960981D346.title: "Механические ленты"
	quest.47385C7A683B68DA.quest_desc: [
		"Тяжёлый пресс для рецептов прессования, недоступных механическому прессу."
	]
	quest.47385C7A683B68DA.title: "Гидравлический пресс"
	quest.47506C8DD20C9A10.quest_desc: [
		"&eSkyworks:&r цинковое сито просеивает гравий на свинец, никель, литий, боксит, лигнит, олово, серебро и серу,"
		"а пыль — на редкие элементы для Chemica (кобальт, сурьма, флюорит, фосфор...)."
	]
	quest.47506C8DD20C9A10.title: "Промышленные минералы"
	quest.484856D325735E76.quest_desc: [
		"Шасси ставится в позвоночник; процессор, ОЗУ и накопитель подключаются к нему в кресле."
		"Каждая деталь - рецепт механических крафтеров с точным механизмом и редстоун-деталью (повторитель, компаратор, лампа, сундук)."
		"Нажмите &eK&r, чтобы писать программы на &eSynapse&r, которые реагируют на тело и управляют имплантами."
		"В полевом руководстве есть первая программа и шпаргалка."
	]
	quest.484856D325735E76.title: "Кибердек"
	quest.48CB630FE4817E70.quest_desc: [
		"Добудьте железную руду на соседних островах. Первым машинам Create нужно немного железа на самородки и пластины."
	]
	quest.48CB630FE4817E70.title: "Первое железо"
	quest.49EA2F7234086678.quest_desc: [
		"Пшеница и вода в бочонке. Подавайте в кружке."
	]
	quest.49EA2F7234086678.title: "Первое пиво"
	quest.4A1535AB9064E28D.quest_desc: [
		"Активатор использует предметы как игрок: ставит, кликает, применяет. Ключ к поэтапной сборке."
	]
	quest.4A1535AB9064E28D.title: "Автономный активатор"
	quest.4B22BAC3229EDF09.quest_desc: [
		"Свитки показывают узоры. Древние свитки учат великим заклинаниям — они есть только в редких тайниках в сундуках древних городов."
	]
	quest.4B22BAC3229EDF09.title: "Свитки"
	quest.4C096BC1BE708852.quest_desc: [
		"Механический миксер без нагрева: 250 мБ воды + слизь + костная мука + сахар = 250 мБ геля."
		"Костная мука: скелеты или компост из лишнего урожая. Сахар: тростник."
		"Каждая операция в кресле тратит 250 мБ - подведите гель трубой прямо к креслу."
	]
	quest.4C096BC1BE708852.title: "Биоинтерфейсный гель"
	quest.4CE5564B2B046AD7.quest_desc: [
		"&eSkyworks:&r зарядная станция Crafts \\& Additions напитывает осколки в заряженный аметист. Industrial Arcana, как она есть."
	]
	quest.4CE5564B2B046AD7.title: "Заряженный аметист"
	quest.4DE87E33A28D168A.quest_desc: [
		"Одноразовое хранилище йоты: записать можно только один раз."
	]
	quest.4DE87E33A28D168A.title: "Узел мысли"
	quest.4E46A1C1C384372B.quest_desc: [
		"Механические проигрыватели и пластинки на силе Create."
	]
	quest.4E46A1C1C384372B.title: "Create Harmonics"
	quest.4E90F25A16EFA321.quest_desc: [
		"Лафет наводится силой вращения: один вход для поворота, другой для угла возвышения."
	]
	quest.4E90F25A16EFA321.title: "Орудийный лафет"
	quest.50A6E78E56C5FD44.quest_desc: [
		"В пустоте Незера парят звёзды из чернокамня с расплавленным ядром. В каждой у лавы спрятано 2–5 древних обломков —"
		"это единственные древние обломки в мире, а значит, единственный незерит."
	]
	quest.50A6E78E56C5FD44.title: "Незерские метеоры"
	quest.50E893A0FAFD1656.quest_desc: [
		"Примените андезитовый сплав к обтёсанному бревну. Из корпусов строятся почти все ранние машины."
	]
	quest.50E893A0FAFD1656.title: "Андезитовый корпус"
	quest.5146A3ED39828566.quest_desc: [
		"Показывайте на большом табло запасы на складе, скорость или расписание поездов."
	]
	quest.5146A3ED39828566.title: "Табло"
	quest.517A7EF4034EE15A.quest_desc: [
		"На поршне или подшипнике жатки собирают урожай, не ломая ферму."
	]
	quest.517A7EF4034EE15A.title: "Жатки"
	quest.51AA85EBCA2AB5EA.quest_desc: [
		"Опускайте груз или подъёмную платформу с корабля на остров внизу."
	]
	quest.51AA85EBCA2AB5EA.title: "Тросовая лебёдка"
	quest.51DDEB7D63261F37.quest_desc: [
		"Оружие Create: Gunsmithing собирается машинами Create. Начните с кремнёвого ружья и бумажных патронов"
		"(бумага + порох + свинцовый самородок). Свинец — цинковое сито или свинцовая руда на островах."
	]
	quest.51DDEB7D63261F37.title: "Кремнёвое ружьё"
	quest.52217CA2F08F44A7.quest_desc: [
		"Орудийные заряжатели (поршни для пушек) автоматизируют заряжание. Добавьте активаторы и ленты — получится линия боеприпасов."
	]
	quest.52217CA2F08F44A7.title: "Автоматическое заряжание"
	quest.52ED050E4CCE07DD.quest_desc: [
		"Вентилятор, дующий сквозь воду, промывает предметы; сквозь лаву — плавит; сквозь огонь — коптит."
		"Промывка гравия даёт железные самородки и кремень: первое возобновляемое железо."
	]
	quest.52ED050E4CCE07DD.title: "Вентилятор"
	quest.54E5A60511D828B5.quest_desc: [
		"Дробление земли даёт нитратную пыль. С возобновляемой землёй Skyworks нитраты полностью автоматизируются."
	]
	quest.54E5A60511D828B5.title: "Нитратная пыль"
	quest.55D6A25EDABC69DF.quest_desc: [
		"Сборка поставляется с низкими настройками (дальность прорисовки 6 чанков). Если ваш ПК тянет больше, увеличьте её в настройках графики."
		"Пресеты «Low-End» и «Standard» описаны в PERFORMANCE в папке docs сборки."
	]
	quest.55D6A25EDABC69DF.title: "Для слабых ПК"
	quest.56421D47FFEFA2DA.quest_desc: [
		"Оборона вблизи от мобов, высадившихся на ваш корабль. Есть стреловидные и зажигательные патроны."
	]
	quest.56421D47FFEFA2DA.title: "Дробовик"
	quest.568B0BC07936FEC4.quest_desc: [
		"Постройте платформу над чанком с жилой и дайте буровой установке мощное вращение:"
		"она добывает сырую руду бесконечно. Отличный повод для рудовозного дирижабля."
	]
	quest.568B0BC07936FEC4.title: "Буровая установка"
	quest.56CE081E97B2325B.quest_desc: [
		"Create Mobile Packages: робо-пчёлы доставляют посылки из пчелиного порта к вам или в другой порт — даже между островами."
	]
	quest.56CE081E97B2325B.title: "Пчёлы-курьеры"
	quest.5789D294E5025EEF.quest_desc: [
		"Переплавьте железо в доменной печи (или вентилятором через лаву), чтобы получить чугун — первый орудийный металл."
	]
	quest.5789D294E5025EEF.title: "Чугун"
	quest.592B15364E351F22.quest_desc: [
		"Графит из руд Chemica или переработки — для электродов и углеродных материалов."
	]
	quest.592B15364E351F22.title: "Графит"
	quest.5A306BB908C7950B.quest_desc: [
		"Пила распиливает брёвна на доски, а на движущемся механизме валит деревья: автоматическая лесоферма."
	]
	quest.5A306BB908C7950B.title: "Механическая пила"
	quest.5AF4E119F5F1933F.quest_desc: [
		"Левитит — парящий кристалл из порошка эндерняка; поднимает корабли без горячего воздуха."
	]
	quest.5AF4E119F5F1933F.title: "Левитит"
	quest.5AF8918A88CADC53.quest_desc: [
		"Пироксилин: бумага + порох + редстоун-окислитель + вода, затем отвердить и размолоть. Бездымный и намного мощнее."
	]
	quest.5AF8918A88CADC53.title: "Нитропорох"
	quest.5B3A1A7003D1A183.quest_desc: [
		"ПКМ посохом открывает сетку заклинаний. Читайте внутриигровой Hex Notebook — магия здесь это программирование."
	]
	quest.5B3A1A7003D1A183.title: "Посох"
	quest.5C33708B4FBC6ABF.quest_desc: [
		"Ящик делит инструменты между слотами панели; медный баллон питает удлинённый захват и водолазное снаряжение."
	]
	quest.5C33708B4FBC6ABF.title: "Ящик для инструментов и баллон"
	quest.5C382ABF6EEBD95A.quest_desc: [
		"Всем имплантам нужно ядро: оно задаёт нейроёмкость и батарею заряда."
		"Механические крафтеры (3x3): железные и медные листы, андезитовые корпуса, точный механизм и блок редстоуна."
		"Редстоун есть на островах или в просеянном песке. Ядро ставится первым."
	]
	quest.5C382ABF6EEBD95A.title: "Кибернетическое ядро"
	quest.5C98BEF5D9140192.quest_desc: [
		"Create Factory Logistics: упаковщики банок отправляют жидкости через сеть посылок Create."
	]
	quest.5C98BEF5D9140192.title: "Жидкости в посылках"
	quest.5CAF9EABBF10A6E6.quest_desc: [
		"Катушки соединяют коннекторы; электричество идёт по проводам."
	]
	quest.5CAF9EABBF10A6E6.title: "Провода"
	quest.5CBECE38555D3F7B.quest_desc: [
		"Города Края (элитры, панцири шалкеров) парят далеко от главного острова. Прочные сита просеивают дроблёный эндерняк на жемчуг."
	]
	quest.5CBECE38555D3F7B.title: "Край"
	quest.5D182F95BE30553F.quest_desc: [
		"Возьмите на борт хранилище или сундуки и возите руду между островами. Помните: в незагруженных чанках корабли останавливаются."
	]
	quest.5D182F95BE30553F.title: "Летающий грузовоз"
	quest.5DC2BDA964E0F365.quest_desc: [
		"Срубите дерево и пересадите каждый саженец. Листва даёт ещё саженцы; не дайте последнему упасть в пустоту."
	]
	quest.5DC2BDA964E0F365.title: "Лес рубят!"
	quest.5DDEC324F016D616.quest_desc: [
		"Мониторы показывают картинку радара; свяжите их с радаром."
	]
	quest.5DDEC324F016D616.title: "Монитор радара"
	quest.5EDB1069661A78FC.quest_desc: [
		"Skyworks добавляет залежи нефти TFMG на дно Незера: постройте там станок-качалку."
	]
	quest.5EDB1069661A78FC.title: "Нефть Незера"
	quest.5EEBAC67C880881D.quest_desc: [
		"Create Encased: ПКМ любым корпусом по валам, шестерням и трубам; латунная коробка передач (Create CA) и Bits 'n' Bobs добавляют новые детали."
	]
	quest.5EEBAC67C880881D.title: "Любой корпус"
	quest.6021EFB935392716.quest_desc: [
		"Включаются в колесе имплантов (удерживайте &eR&r) и позволяют ходить по железным, медным и металлическим стенам Create."
		"Ключевой предмет: железные ботинки, плюс поршень. Пока держитесь, тратится заряд."
	]
	quest.6021EFB935392716.title: "Магнитные подошвы"
	quest.6117481665174663.quest_desc: [
		"Slice \\& Dice: слайсер выполняет рецепты разделочной доски силой Create."
	]
	quest.6117481665174663.title: "Автоматическая нарезка"
	quest.61837379F54F39F1.quest_desc: [
		"Кинетические загрузчики чанков держат завод в работе, пока вас нет. Латунный работает и на дирижаблях, и на поездах"
		"(Skyworks ограничивает его зоной 3x3 чанка, чтобы не нагружать сервер)."
	]
	quest.61837379F54F39F1.title: "Загрузчики чанков"
	quest.621DD98607AA5B65.quest_desc: [
		"Create Big Cannons 5.11 поддерживает Sable: пушки собираются на дирижаблях, отдача толкает корабль, а выстрелы"
		"наследуют скорость корабля. На выделенном сервере проверены только сборка и загрузка — смотрите TEST_RESULTS.md, прежде чем полагаться на это в бою."
	]
	quest.621DD98607AA5B65.title: "Мобильная артиллерия"
	quest.62365C3B7FECBCA5.quest_desc: [
		"Inventory Profiles Next: средняя кнопка мыши (или кнопки) сортирует контейнеры; автопополнение заменяет сломанные инструменты."
		"Mouse Tweaks: колесо — перемещение предметов, перетаскивание — раскладка."
	]
	quest.62365C3B7FECBCA5.title: "Сортировка инвентаря"
	quest.6368F2E8D3884CDF.quest_desc: [
		"Жернов перемалывает булыжник в гравий, гравий — в кремень и многое другое. Гравий — основа всей руды на скайблоке."
	]
	quest.6368F2E8D3884CDF.title: "Жернов"
	quest.63E1AD87667D5023.quest_desc: [
		"HexFlow добавляет узоры итераций и управления потоком; HexParse позволяет писать хексы текстом и компилировать их."
	]
	quest.63E1AD87667D5023.title: "Циклы и управление (HexFlow)"
	quest.64FF4843F9EAC0E7.quest_desc: [
		"Ректификационные колонны разделяют нефть на мазут, дизель, керосин, нафту, бензин и газ."
	]
	quest.64FF4843F9EAC0E7.title: "Перегонка"
	quest.652EEAA15F1C216E.quest_desc: [
		"Падение в пустоту уничтожает ваши вещи. Приседайте у края, ставьте перила на мостах"
		"и оставляйте ценности в сундуке дома перед вылазкой."
	]
	quest.652EEAA15F1C216E.title: "Безопасность у пустоты"
	quest.65ACFC896AF3BB36.quest_desc: [
		"Генераторы превращают вращение в FE, электромоторы — обратно. Зарядные станции могут заряжать и аметист."
	]
	quest.65ACFC896AF3BB36.title: "Электричество (Crafts \\& Additions)"
	quest.669BFA6E4544D882.quest_desc: [
		"В настройках графики есть дополнительные страницы Sodium (Sodium Extra): отключите анимации, частицы и туман при низком FPS."
		"Dynamic FPS снижает частоту кадров, когда игра свёрнута."
		"Пресеты: scripts/apply-preset.sh lowend|standard или docs/PERFORMANCE.md."
	]
	quest.669BFA6E4544D882.title: "Плавно на слабых ПК"
	quest.66AC030929148B70.quest_desc: [
		"Вы стоите на маленьком острове над бесконечной пустотой. Во все стороны парят другие острова:"
		"маленькие острова-конусы из леса, пустыни или снега, 20–40 блоков в поперечнике и далеко друг от друга, и редкие кварцевые метеоры."
		""
		"&cПадение в пустоту смертельно, а вещи пропадают.&r Стройте осторожно и ставьте перила на мостах."
		"Откройте стартовый сундук у дерева: лёд (вода), ведро лавы, набор капельника для лавы, мох, сахарный тростник, семена и громоотвод."
	]
	quest.66AC030929148B70.quest_subtitle: "Прочитайте в первую очередь"
	quest.66AC030929148B70.title: "Добро пожаловать в небо"
	quest.66BF0332DF5E032E.quest_desc: [
		"Прочный лист Create: обсидиановая пыль (раздробите обсидиан из лавы генератора булыжника), прессовка и сборка."
	]
	quest.66BF0332DF5E032E.title: "Прочные листы"
	quest.671D5C90804C60D5.quest_desc: [
		"Подшипник бура вгрызается в породу на ходу — мобильный добытчик руды."
	]
	quest.671D5C90804C60D5.title: "Горнодобывающая техника"
	quest.67592D8143B4377A.quest_desc: [
		"Шифры, безделушки и артефакты хранят хекс, который срабатывает одним кликом."
	]
	quest.67592D8143B4377A.title: "Предметы-заклинатели"
	quest.67ACCBA3D1C9EDDB.quest_desc: [
		"Гравий через андезитовое сито: самородки железа, меди, цинка и золота, уголь и кремень."
		"Песок даёт редстоун, золотые самородки, кактус и порох; пыль — светокаменную пыль, редстоун и огненный порошок."
	]
	quest.67ACCBA3D1C9EDDB.title: "Андезитовое сито"
	quest.67EFE32ED7217297.quest_desc: [
		"Умные пропеллеры автоматически регулируют тягу по сигналу редстоуна."
	]
	quest.67EFE32ED7217297.title: "Умные пропеллеры"
	quest.6816537571119F05.quest_desc: [
		"Просеиватель трясёт сыпучие материалы через сито. Нитяное сито просеивает землю на семена и камешки."
	]
	quest.6816537571119F05.title: "Просеиватель"
	quest.689195DD51C0F71D.quest_desc: [
		"Рука переносит предметы между множеством входов и выходов в радиусе. Указывайте цели ПКМ, держа руку в руке."
	]
	quest.689195DD51C0F71D.title: "Механическая рука"
	quest.68C9327CA9E5490E.quest_desc: [
		"Указывает на немногие существующие постройки: крепости, крепости Незера, метеоры, древние города и города Края."
	]
	quest.68C9327CA9E5490E.title: "Компас исследователя"
	quest.68FC8473B7AB0032.quest_desc: [
		"Генерируются только крепости, крепости Незера, незерские метеоры, древние города и города Края — ни деревень, ни руин, ни подземелий."
		"Ни одна постройка не ближе 1000 блоков к стартовому острову, а две одинаковые стоят в 700–1000 блоках друг от друга. Сначала постройте дирижабль."
	]
	quest.68FC8473B7AB0032.title: "Ничего рядом с домом"
	quest.6993A02DD08DEE82.quest_desc: [
		"Датчики высоты, скорости и кардана выдают сигнал редстоуна — соберите удержание высоты."
	]
	quest.6993A02DD08DEE82.title: "Датчики автопилота"
	quest.6AE850C86CA23677.quest_desc: [
		"Удерживайте &eW&r почти над любым блоком Create (и многих аддонов), чтобы посмотреть анимированное обучение."
	]
	quest.6AE850C86CA23677.title: "Ponder"
	quest.6C2D9081C3A1E5E3.quest_desc: [
		"Туннели поровну делят поток на ленте. Латунные туннели умеют фильтровать и раздавать по кругу."
	]
	quest.6C2D9081C3A1E5E3.title: "Туннели"
	quest.6C3E8975993C5B03.quest_desc: [
		"Там, где был бы океан, — открытая пустота лишь с редкими маленькими островками. Продумайте топливо и путь домой, прежде чем пересекать."
	]
	quest.6C3E8975993C5B03.title: "Моря пустоты"
	quest.6C9B1AD4A0EEF1C9.quest_desc: [
		"В химических чанах идут электролиз, кислотные реакции и выщелачивание. Многим рецептам Chemica нужна особая сборка чана (см. JEI)."
	]
	quest.6C9B1AD4A0EEF1C9.title: "Химический чан"
	quest.6D0FA79299F60AAC.quest_desc: [
		"Супы и рагу дают долгие баффы. Нужен источник жара снизу (костёр, печь, горелка ифрита)."
	]
	quest.6D0FA79299F60AAC.title: "Кастрюля"
	quest.6F1D1F8AEFACE8F3.quest_desc: [
		"Углепластик: прочный и лёгкий — лучший материал для дирижаблей."
	]
	quest.6F1D1F8AEFACE8F3.title: "Углеволокно"
	quest.6F3007E6EF2FAB11.quest_desc: [
		"Create: Sound of Steam — органы, звучащие от пара и клавиатурного реле."
	]
	quest.6F3007E6EF2FAB11.title: "Органные трубы"
	quest.6F7B859A75FDDBA3.quest_desc: [
		"Газоразрядные индикаторы, лампы, плитка, цепные блоки и другая декоративная механика."
	]
	quest.6F7B859A75FDDBA3.title: "Bits 'n' Bobs"
	quest.6F92F828EC5DE890.quest_desc: [
		"Поставьте блок капельника, сверху — источник лавы, снизу подвесьте острый капельник."
		"Лава медленно капает с кончика: ловите её ведром — возобновляемая лава ещё до похода в Незер."
	]
	quest.6F92F828EC5DE890.title: "Лавовая ферма на капельнике"
	quest.6FD16C5056F24AFC.quest_desc: [
		"Миномёт навесом перебрасывает снаряды через укрытия — простая артиллерия для обороны острова."
	]
	quest.6FD16C5056F24AFC.title: "Миномёты"
	quest.6FF396E54FCD0BFA.quest_desc: [
		"Сера + нитрат + вода в чане. Кислоты выщелачивают руду с бонусным выходом и нужны для нитрования."
	]
	quest.6FF396E54FCD0BFA.title: "Серная кислота"
	quest.7086BE69AFBF7B50.quest_desc: [
		"Поймайте ифрита в крепости Незера пустой горелкой. Топливо в горелке нагревает чашу."
		"Сильный нагрев (пирог ифрита) открывает самые сложные рецепты."
	]
	quest.7086BE69AFBF7B50.title: "Горелка ифрита"
	quest.70CBE8C3AB1F79AB.quest_desc: [
		"Помпы гонят жидкость по трубам; носики наполняют предметы, сливы их опустошают."
	]
	quest.70CBE8C3AB1F79AB.title: "Жидкости"
	quest.70F6343913A9600F.quest_desc: [
		"Перегоните спиртовую основу. Разливайте её по бутылкам прямо трубами Create."
	]
	quest.70F6343913A9600F.title: "Водка"
	quest.711AAC39C4C2F1C9.quest_desc: [
		"ПКМ — выбрать биом; стрелка укажет на ближайший остров этого биома."
	]
	quest.711AAC39C4C2F1C9.title: "Компас природы"
	quest.71202E69E0ADE94F.quest_desc: [
		"Create Radars: вращающийся радарный подшипник с антенными пластинами обнаруживает корабли, мобов и игроков."
	]
	quest.71202E69E0ADE94F.title: "Радар"
	quest.71D346AED6E0238E.quest_desc: [
		"Миксер смешивает предметы и жидкости в чаше."
		"&eРецепт Skyworks:&r гравий + 2 костной муки + вода = земля (возобновляемая земля для ферм, просеивания и нитратов)."
	]
	quest.71D346AED6E0238E.title: "Механический миксер"
	quest.72BDE71486CECCE2.quest_desc: [
		"Полированный розовый кварц (кварц + редстоун, затем отшлифовать) на железном листе."
		"Они нужны оптическим, нейро- и скоростным имплантам и каждому улучшению до Mk. II."
	]
	quest.72BDE71486CECCE2.title: "Электронные лампы"
	quest.73ABCF0CEC3253F5.quest_desc: [
		"Кусты винограда растут на островах с равнинами и лесами. &eSkyworks:&r просеивание земли через нитяное сито тоже может дать кусты красного и белого винограда."
	]
	quest.73ABCF0CEC3253F5.title: "Виноград"
	quest.73BE0F0BDFA1984A.quest_desc: [
		"Offroad: колёса превращают постройки в машины и грузовики для больших островов."
	]
	quest.73BE0F0BDFA1984A.title: "Наземный транспорт"
	quest.73D37279BAB42206.quest_desc: [
		"Пресс расплющивает слитки в пластины (нужны для пропеллеров, суперклея и др.) и прессует предметы в чаше."
	]
	quest.73D37279BAB42206.title: "Механический пресс"
	quest.73E60C0C2CF9333A.quest_desc: ["Прокатывает слитки в стержни и провода."]
	quest.73E60C0C2CF9333A.title: "Прокатный стан"
	quest.73FF53F5F1401D4D.quest_desc: [
		"Улучшения - это последовательная сборка: положите имплант Mk. I на ленту (JEI: применения импланта). Старый имплант расходуется."
		"Mk. II = деталь категории, электронная лампа, 100 мБ биогеля, латунный лист и пресс - один цикл."
		"Креслу нужно 32 об/мин. Настройки сохраняются, когда вы меняете имплант на улучшенный."
	]
	quest.73FF53F5F1401D4D.title: "Грейд II: промышленный"
	quest.7494612A2B8E4718.quest_desc: [
		"Поршни, подшипники, портальные краны и вагонетки двигают целые машины. Скрепите их суперклеем."
	]
	quest.7494612A2B8E4718.title: "Механизмы"
	quest.74D76E6BDBD7B706.quest_desc: [
		"Котлы на баках с жаром и водой: большая и надёжная мощность для заводов."
	]
	quest.74D76E6BDBD7B706.title: "Паровые двигатели"
	quest.74F692CBB751DD8F.quest_desc: [
		"Древние обломки, выплавленные в лом: в метеорах Нижнего мира по 2-5 обломков. Каждый цикл Mk. IV тратит один лом."
	]
	quest.74F692CBB751DD8F.title: "Незеритовый лом"
	quest.75261E297BA4F9C4.quest_desc: [
		"Списочные фильтры и фильтры по атрибутам задают, что принимают воронки, руки и умные желоба."
	]
	quest.75261E297BA4F9C4.title: "Фильтры"
	quest.760C1B9585D6A7CA.quest_desc: [
		"Наведите на предмет и нажмите &eR&r — рецепты, &eU&r — применения."
		"Введите &e@create&r, чтобы отфильтровать по моду, &e#tag&r — по тегам. Закладки — клавиша &eA&r."
	]
	quest.760C1B9585D6A7CA.title: "Поиск рецептов (JEI)"
	quest.764CA684D85432C8.quest_desc: [
		"Дробильные колёса превращают булыжник → гравий → песок → пыль для просеивателя, с бонусными побочными продуктами."
	]
	quest.764CA684D85432C8.title: "Дробильные колёса"
	quest.76FC3FAB88E63449.quest_desc: [
		"MieHex добавляет йоты зачарований и «идей»: читайте, объединяйте и накладывайте зачарования гексами."
		"Его страницы есть в Hex Notebook."
	]
	quest.76FC3FAB88E63449.title: "Йоты зачарований"
	quest.77A375DCACD0FFE9.quest_desc: [
		"Create: Alcohol Industry — автоматическое производство пива, сидра, водки, виски, рома и текилы с прессами, бочками и котлом."
	]
	quest.77A375DCACD0FFE9.title: "Спиртзавод"
	quest.77BAFF4125A40C99.quest_desc: [
		"Упаковщики пакуют предметы; лягушкопорты бросают посылки по цепям между вашими островами."
	]
	quest.77BAFF4125A40C99.title: "Посылки и лягушкопорты"
	quest.77C7E2CD8644EE9D.quest_desc: [
		"Водяное колесо в текущей воде — классический первый источник энергии. В крайнем случае подойдёт ручной вороток."
	]
	quest.77C7E2CD8644EE9D.title: "Энергия воды"
	quest.78736E09A36C348D.quest_desc: [
		"Больший и мощный вентилятор для крупных линий обработки."
	]
	quest.78736E09A36C348D.title: "Промышленный вентилятор"
	quest.7886C03B8FC2B253.quest_desc: [
		"Каждый остров — одинокий конус 20–40 блоков в поперечнике, не ближе 100 блоков к соседнему, вершины на высоте y 70–190."
		"Руды мало (примерно 1 блок из 80): разбирайте острова целиком или автоматизируйте."
	]
	quest.7886C03B8FC2B253.title: "Прыжки по островам"
	quest.7950C2292976672B.quest_desc: [
		"Древние города лежат глубоко под островами, в глубокой тьме. В немногих сундуках (примерно 1 из 20) — тайник с древним свитком:"
		"великое заклинание Hex Casting, заряженный аметист и эхо-осколки. Берегитесь хранителя."
	]
	quest.7950C2292976672B.title: "Древние города"
	quest.79BBD2C057B4BDC7.quest_desc: [
		"Сера получается дроблением редстоуновой руды, из залежей серы в Незере или цинковым ситом."
	]
	quest.79BBD2C057B4BDC7.title: "Сера"
	quest.79DC285C1B684A45.quest_desc: [
		"Двигатели TFMG сжигают бензин, дизель или газ и дают огромную силу вращения — мощный двигатель для дирижабля."
	]
	quest.79DC285C1B684A45.title: "Двигатели внутреннего сгорания"
	quest.7A2390DEC289F3A2.quest_desc: [
		"Латунь, медь, железо и порох. Бросайте, а не держите."
	]
	quest.7A2390DEC289F3A2.title: "Осколочные гранаты"
	quest.7A67274EA98F515F.quest_desc: [
		"4 лома + 4 золотых слитка. Каждый цикл Mk. V кладёт один слиток: на полный комплект обыщите метеоры Нижнего мира."
	]
	quest.7A67274EA98F515F.title: "Незеритовые слитки"
	quest.7AEE999F087590EF.quest_desc: [
		"Штурвалы, рычаги тяги и редстоун-связь позволяют управлять кораблём из рубки."
		"Не каждая машина Create работает на движущемся корабле — проверяйте и смотрите COMPATIBILITY.md в папке docs."
	]
	quest.7AEE999F087590EF.title: "Управление"
	quest.7CF10D61633AF28C.quest_desc: [
		"Вспашите землю рядом с водой и посадите семена. Костная мука ускоряет рост."
		"Животные не появляются на стартовом острове — ищите их на травяных островах поблизости."
	]
	quest.7CF10D61633AF28C.title: "Хлеб, а не пустота"
	quest.7E3C4A35D05AD2D6.quest_desc: [
		"Immersive Paintings: ПКМ по повешенной картине, чтобы загрузить любое изображение — оно будет пикселизовано."
	]
	quest.7E3C4A35D05AD2D6.title: "Свои картины"
	quest.7F407C1431274E25.quest_desc: [
		"Сквозь лаву — плавка. Сквозь огонь — копчение. Сквозь огонь душ — призрачная обработка."
	]
	quest.7F407C1431274E25.title: "Плавка и копчение вентилятором"
}
